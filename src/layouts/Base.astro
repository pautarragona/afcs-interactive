---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { course } from '../data/course';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const { title, description = 'An open, interactive companion to TU Delft AE4301 Automatic Flight Control System Design.', current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=B612:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to the lesson</a>
    <div class="shell">
      <aside class="toc" aria-label="Course contents">
        <a class="brand" href={base}>Interactive AFCS</a>
        <p class="byline">A companion to TU Delft AE4301</p>
        <nav aria-label="Lessons">
          {course.map((track) => (
            <>
              <p class="track">{track.name}</p>
              <ol>
                {track.lessons.map((l) => (
                  <li class:list={[{ current: l.slug === current, soon: !l.slug }]}>
                    <span class="id">{l.id}</span>
                    {l.slug ? (
                      <a href={`${base}lessons/${l.slug}/`} aria-current={l.slug === current ? 'page' : undefined}>{l.title}</a>
                    ) : (
                      <span>{l.title}<span class="sr"> (coming later)</span></span>
                    )}
                  </li>
                ))}
              </ol>
            </>
          ))}
        </nav>
        <button type="button" class="theme btn-line" data-theme-toggle>
          <span class="to-dark">Dark mode</span><span class="to-light">Light mode</span>
        </button>
      </aside>
      <main id="content" class="main">
        <slot />
        <footer class="foot">
          <p>Content CC BY 4.0, code MIT. A companion to the AE4301 lectures, not a replacement for them.</p>
          <p><a href="https://github.com/pautarragona/afcs-interactive">Source, corrections and issues on GitHub</a></p>
        </footer>
      </main>
    </div>
    <script>
      const root = document.documentElement;
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; background: var(--paper); padding: 8px 12px; z-index: 10; }
  .shell { display: flex; flex-wrap: wrap; align-items: stretch; min-height: 100vh; }
  .toc { flex: 1 1 240px; max-width: 290px; padding: 28px 24px; border-right: 1px solid var(--rule); font-size: 14px; }
  .brand { display: block; font-weight: 700; font-size: 16px; color: var(--ink); text-decoration: none; }
  .byline { margin: 4px 0 26px; font-family: var(--font-text); font-size: 15px; color: var(--muted); }
  .track { margin: 0 0 6px; color: var(--muted); }
  ol { list-style: none; margin: 0 0 22px; padding: 0; }
  li { display: grid; grid-template-columns: 26px 1fr; padding: 4px 0; position: relative; }
  li .id { color: var(--muted); }
  li a { color: var(--ink); text-decoration: none; }
  li a:hover { text-decoration: underline; }
  li.soon { color: var(--muted); }
  li.current .id, li.current a { font-weight: 700; color: var(--ink); }
  li.current::before { content: ''; position: absolute; left: -14px; top: 9px; border-left: 8px solid var(--grab); border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .sr { position: absolute; left: -9999px; }
  .theme { margin-top: 8px; }
  .to-light { display: none; }
  :global(:root[data-theme='dark']) .to-dark { display: none; }
  :global(:root[data-theme='dark']) .to-light { display: inline; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .to-dark { display: none; }
    :global(:root:not([data-theme='light'])) .to-light { display: inline; }
  }
  .main { flex: 999 1 640px; min-width: 0; max-width: var(--page); padding: 32px clamp(16px, 4vw, 56px) 64px; }
  .foot { margin-top: 80px; padding-top: 16px; border-top: 1px solid var(--rule); font-family: var(--font-text); font-size: 15px; color: var(--muted); }
  .foot p { margin: 4px 0; }
  @media (max-width: 900px) {
    .toc { max-width: none; border-right: none; border-bottom: 1px solid var(--rule); }
  }
</style>
